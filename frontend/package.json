{
  "name": "hermes-finance-frontend",
  "private": true,
  "version": "1.9.0",
  "type": "module",
  "engines": {
    "node": "^22.23.1 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format-check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "audit:visual": "node scripts/run-visual-audit.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:capital-allocation": "playwright test --project=capital-allocation",
    "test:e2e:alfa": "playwright test --project=alfa",
    "test:e2e:broker-month": "playwright test --project=broker-month",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:iis": "playwright test --project=iis",
    "test:e2e:instrument-eod": "playwright test --project=instrument-eod",
    "test:e2e:instrument-income": "playwright test --project=instrument-income",
    "test:e2e:instrument-trades": "playwright test --project=instrument-trades",
    "test:e2e:instrument-uat": "playwright test --project=instrument-uat",
    "test:e2e:instrument-what-if": "playwright test --project=instrument-what-if",
    "test:e2e:month-editor": "playwright test --project=month-editor",
    "test:e2e:monthly-close": "playwright test --project=monthly-close",
    "test:e2e:payout": "playwright test --project=payout",
    "test:e2e:provisional": "playwright test --project=provisional",
    "test:e2e:quote-mapping": "playwright test --project=quote-mapping",
    "test:e2e:statement": "playwright test --project=statement",
    "test:e2e:what-if": "playwright test --project=what-if"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
