{
  "name": "hermes-finance-frontend",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format --write .",
