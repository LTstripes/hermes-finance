{
  "$defs": {
    "CleanExportAccount": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/CleanExportPeriod"
        },
        "instruments": {
          "items": {
            "$ref": "#/$defs/CleanInstrument"
          },
          "title": "Instruments",
          "type": "array"
        },
        "gaps": {
          "items": {
            "$ref": "#/$defs/CleanGap"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "account_ref",
        "period",
        "instruments",
        "gaps"
      ],
      "title": "CleanExportAccount",
      "type": "object"
    },
    "CleanExportPeriod": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CleanExportPeriod",
      "type": "object"
    },
    "CleanExportUnits": {
      "additionalProperties": false,
      "properties": {
        "money": {
          "const": "integer_kopecks",
          "title": "Money",
          "type": "string"
        },
        "modified_dietz": {
          "const": "fraction_of_weighted_capital",
          "title": "Modified Dietz",
          "type": "string"
        },
        "period": {
          "const": "opening_eod_exclusive_closing_eod_inclusive",
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "money",
        "modified_dietz",
        "period"
      ],
      "title": "CleanExportUnits",
      "type": "object"
    },
    "CleanGap": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "month": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Month"
        },
        "isin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Isin"
        }
      },
      "required": [
        "code",
        "month",
        "isin"
      ],
      "title": "CleanGap",
      "type": "object"
    },
    "CleanInstrument": {
      "additionalProperties": false,
      "properties": {
        "isin": {
          "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
          "title": "Isin",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "instrument_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instrument Type"
        },
        "opening_date": {
          "format": "date",
          "title": "Opening Date",
          "type": "string"
        },
        "closing_date": {
          "format": "date",
          "title": "Closing Date",
          "type": "string"
        },
        "opening_value": {
          "$ref": "#/$defs/CleanMetric"
        },
        "closing_value": {
          "$ref": "#/$defs/CleanMetric"
        },
        "buys": {
          "$ref": "#/$defs/CleanMetric"
        },
        "sells": {
          "$ref": "#/$defs/CleanMetric"
        },
        "coupons": {
          "$ref": "#/$defs/CleanMetric"
        },
        "dividends": {
          "$ref": "#/$defs/CleanMetric"
        },
        "payouts": {
          "$ref": "#/$defs/CleanMetric"
        },
        "redemption": {
          "$ref": "#/$defs/CleanMetric"
        },
        "valuation_and_trades": {
          "$ref": "#/$defs/CleanMetric"
        },
        "known_result": {
          "$ref": "#/$defs/CleanMetric"
        },
        "pnl": {
          "$ref": "#/$defs/CleanMetric"
        },
        "modified_dietz": {
          "$ref": "#/$defs/CleanMetric"
        }
      },
      "required": [
        "isin",
        "name",
        "instrument_type",
        "opening_date",
        "closing_date",
        "opening_value",
        "closing_value",
        "buys",
        "sells",
        "coupons",
        "dividends",
        "payouts",
        "redemption",
        "valuation_and_trades",
        "known_result",
        "pnl",
        "modified_dietz"
      ],
      "title": "CleanInstrument",
      "type": "object"
    },
    "CleanMetric": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "status": {
          "enum": [
            "supported",
            "provisional",
            "partial",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "value",
        "status",
        "reason_codes",
        "assumptions"
      ],
      "title": "CleanMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "hermes.finance.clean_returns",
      "title": "Contract",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_contract": {
      "const": "clean_returns_overview_v1",
      "title": "Source Contract",
      "type": "string"
    },
    "basis": {
      "const": "clean_principal_and_valuation_with_received_cash",
      "title": "Basis",
      "type": "string"
    },
    "authority": {
      "const": "provisional",
      "title": "Authority",
      "type": "string"
    },
    "currency": {
      "const": "RUB",
      "title": "Currency",
      "type": "string"
    },
    "units": {
      "$ref": "#/$defs/CleanExportUnits"
    },
    "accounts": {
      "items": {
        "$ref": "#/$defs/CleanExportAccount"
      },
      "title": "Accounts",
      "type": "array"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "source_contract",
    "basis",
    "authority",
    "currency",
    "units",
    "accounts"
  ],
  "title": "CleanReturnsExport",
  "type": "object"
}
