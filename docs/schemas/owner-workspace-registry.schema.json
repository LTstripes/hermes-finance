{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner-local workspace registry (never commit a populated registry)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspace_roots", "entries"],
  "properties": {
    "version": {"const": 1, "type": "integer"},
    "workspace_roots": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/path"}},
    "entries": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "description": "Absolute local path; no links, device/UNC paths or parent traversal. Populated paths remain Owner-local."},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {"enum": ["stable", "control", "preview", "workspace", "unknown"]},
        "path": {"$ref": "#/$defs/path"},
        "data_path": {"$ref": "#/$defs/path"},
        "expected_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "release_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "active": {"type": "boolean", "description": "Omitted workspace ownership is treated as active."},
        "artifacts_resolved": {"type": "boolean", "description": "Owner attestation; never grants deletion permission."}
      }
    }
  }
}
