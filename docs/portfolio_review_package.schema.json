{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-finance.local/schema/portfolio-review-package/1.0.0/schema.json",
  "title": "Hermes Finance portfolio review package",
  "description": "Versioned read-only portfolio-review package. Financial values and classifications are supplied by existing Hermes read models; this schema defines the safe transport contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "metadata",
    "profile",
    "scope",
    "sections",
    "field_states",
    "warnings"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_name": {"const": "hermes.finance.portfolio_review_package"},
    "schema_version": {"const": "1.0.0"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "profile": {"enum": ["concise", "full"]},
    "scope": {"$ref": "#/$defs/scope"},
    "sections": {"$ref": "#/$defs/sections"},
    "field_states": {
      "type": "array",
      "items": {"$ref": "#/$defs/field_state"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "currency": {"const": "RUB"}
      }
    },
    "availability": {
      "enum": ["available", "unavailable"]
    },
    "precision": {
      "enum": ["exact", "approximate", "unknown"]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 96
      }
    },
    "money_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "availability", "precision", "source", "reason_codes"],
      "properties": {
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/money"},
            {"type": "null"}
          ]
        },
        "availability": {"$ref": "#/$defs/availability"},
        "precision": {"$ref": "#/$defs/precision"},
        "source": {
          "enum": [
            "backend_derived",
            "persisted_configuration",
            "persisted_snapshot",
            "persisted_actual",
            "persisted_expected",
            "merged_payout_calendar"
          ]
        },
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"availability": {"const": "available"}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "value": {"$ref": "#/$defs/money"},
              "precision": {"enum": ["exact", "approximate"]}
            }
          }
        },
        {
          "if": {
            "properties": {"availability": {"const": "unavailable"}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "value": {"type": "null"},
              "precision": {"const": "unknown"}
            }
          }
        }
      ]
    },
    "ratio_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_pct", "availability", "precision", "source", "reason_codes"],
      "properties": {
        "value_pct": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
            },
            {"type": "null"}
          ]
        },
        "availability": {"$ref": "#/$defs/availability"},
        "precision": {"$ref": "#/$defs/precision"},
        "source": {"const": "backend_derived"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"availability": {"const": "available"}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "value_pct": {"type": "string"},
              "precision": {"enum": ["exact", "approximate"]}
            }
          }
        },
        {
          "if": {
            "properties": {"availability": {"const": "unavailable"}},
            "required": ["availability"]
          },
          "then": {
            "properties": {
              "value_pct": {"type": "null"},
              "precision": {"const": "unknown"}
            }
          }
        }
      ]
    },
    "date_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "availability", "reason_codes"],
      "properties": {
        "value": {
          "oneOf": [
            {"type": "string", "format": "date"},
            {"type": "null"}
          ]
        },
        "availability": {"$ref": "#/$defs/availability"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"availability": {"const": "available"}},
            "required": ["availability"]
          },
          "then": {"properties": {"value": {"type": "string", "format": "date"}}}
        },
        {
          "if": {
            "properties": {"availability": {"const": "unavailable"}},
            "required": ["availability"]
          },
          "then": {"properties": {"value": {"type": "null"}}}
        }
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month"],
      "properties": {
        "year": {"type": "integer", "minimum": 1900, "maximum": 9999},
        "month": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    },
    "coverage_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "provider", "observed_at"],
      "properties": {
        "source_kind": {
          "enum": ["manual", "provider", "statement", "migration", "backend_derived"]
        },
        "provider": {
          "type": ["string", "null"],
          "enum": [null, "t_invest", "alfa_pro", "alfa_statement"]
        },
        "observed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "as_of_date",
        "base_currency",
        "application",
        "generation_mode",
        "source_contract_name",
        "source_contract_version",
        "calculation_versions",
        "ordering_contract"
      ],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "as_of_date": {"type": "string", "format": "date"},
        "base_currency": {"const": "RUB"},
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "Hermes Finance"},
            "version": {"type": ["string", "null"], "maxLength": 64}
          }
        },
        "generation_mode": {"const": "read_only"},
        "source_contract_name": {"const": "hermes.finance.ai_analysis_bundle"},
        "source_contract_version": {"const": "1.0.0"},
        "calculation_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monthly_summary",
            "passive_income_forecast",
            "goal_achievement",
            "freshness_provenance",
            "risk_allocation",
            "deterministic_insights"
          ],
          "properties": {
            "monthly_summary": {"type": "string", "minLength": 1, "maxLength": 64},
            "passive_income_forecast": {"type": "string", "minLength": 1, "maxLength": 64},
            "goal_achievement": {"type": "string", "minLength": 1, "maxLength": 64},
            "freshness_provenance": {"type": "string", "minLength": 1, "maxLength": 64},
            "risk_allocation": {"type": "string", "minLength": 1, "maxLength": 64},
            "deterministic_insights": {"type": "string", "minLength": 1, "maxLength": 64}
          }
        },
        "ordering_contract": {
          "const": "sections_and_arrays_are_sorted_as_defined_by_contract"
        }
      }
    },
    "section_id": {
      "enum": [
        "capital",
        "positions",
        "dynamics",
        "passive_income",
        "future_cash_flows",
        "freshness",
        "allocation",
        "context",
        "deterministic_insights"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reporting_period",
        "reporting_status",
        "selection_reason",
        "history_start_period",
        "history_end_period",
        "missing_calendar_periods",
        "requested_sections"
      ],
      "properties": {
        "reporting_period": {"$ref": "#/$defs/period"},
        "reporting_status": {"enum": ["closed", "draft"]},
        "selection_reason": {"enum": ["latest_closed", "latest_available"]},
        "history_start_period": {"$ref": "#/$defs/period"},
        "history_end_period": {"$ref": "#/$defs/period"},
        "missing_calendar_periods": {
          "type": "array",
          "items": {"$ref": "#/$defs/period"}
        },
        "requested_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/section_id"}
        }
      }
    },
    "field_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "reason_codes", "message"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^sections\\.[a-z][a-z0-9_]*(\\.[a-zA-Z0-9_\\[\\]\\*]+)*$",
          "maxLength": 256
        },
        "status": {"enum": ["unavailable", "omitted"]},
        "reason_codes": {"$ref": "#/$defs/reason_codes"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "scope", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 96},
        "severity": {"enum": ["info", "warning", "error"]},
        "scope": {"type": "string", "minLength": 1, "maxLength": 256},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "name", "account_type", "status", "include_in_capital", "include_in_returns"],
      "properties": {
        "ref": {"type": "string", "pattern": "^acct-[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "account_type": {"enum": ["brokerage", "iis", "deposit", "savings", "cash", "other"]},
        "status": {"enum": ["active", "frozen", "closed", "hidden"]},
        "include_in_capital": {"type": "boolean"},
        "include_in_returns": {"type": "boolean"}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "name", "instrument_type", "isin", "ticker", "currency"],
      "properties": {
        "ref": {"type": "string", "pattern": "^inst-[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "instrument_type": {"enum": ["stock", "bond", "fund", "currency", "gold", "other"]},
        "isin": {"type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
        "ticker": {"type": ["string", "null"], "maxLength": 32},
        "currency": {"const": "RUB"}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_ref",
        "instrument_ref",
        "quantity",
        "market_price_per_unit",
        "market_value",
        "cost_basis",
        "unrealized_result",
        "accrued_interest",
        "price_date",
        "valuation_provenance"
      ],
      "properties": {
        "account_ref": {"type": "string", "pattern": "^acct-[a-z0-9-]+$"},
        "instrument_ref": {"type": "string", "pattern": "^inst-[a-z0-9-]+$"},
        "quantity": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "market_price_per_unit": {"$ref": "#/$defs/money_metric"},
        "market_value": {"$ref": "#/$defs/money_metric"},
        "cost_basis": {"$ref": "#/$defs/money_metric"},
        "unrealized_result": {"$ref": "#/$defs/money_metric"},
        "accrued_interest": {"$ref": "#/$defs/money_metric"},
        "price_date": {"$ref": "#/$defs/date_metric"},
        "valuation_provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "deposit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_ref",
        "name",
        "deposit_type",
        "balance",
        "annual_rate_pct",
        "expected_monthly_interest",
        "actual_interest_received",
        "provenance"
      ],
      "properties": {
        "account_ref": {"type": "string", "pattern": "^acct-[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "deposit_type": {"enum": ["deposit", "savings"]},
        "balance": {"$ref": "#/$defs/money_metric"},
        "annual_rate_pct": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"},
        "expected_monthly_interest": {"$ref": "#/$defs/money_metric"},
        "actual_interest_received": {"$ref": "#/$defs/money_metric"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "cash_balance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_ref", "name", "amount", "include_in_capital", "provenance"],
      "properties": {
        "account_ref": {"type": "string", "pattern": "^acct-[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "amount": {"$ref": "#/$defs/money_metric"},
        "include_in_capital": {"type": "boolean"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "capital_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reporting_period",
        "snapshot_date",
        "liquid_assets_total",
        "included_debts",
        "liquid_capital_net",
        "property_equity",
        "total_net_worth"
      ],
      "properties": {
        "reporting_period": {"$ref": "#/$defs/period"},
        "snapshot_date": {"type": "string", "format": "date"},
        "liquid_assets_total": {"$ref": "#/$defs/money_metric"},
        "included_debts": {"$ref": "#/$defs/money_metric"},
        "liquid_capital_net": {"$ref": "#/$defs/money_metric"},
        "property_equity": {"$ref": "#/$defs/money_metric"},
        "total_net_worth": {"$ref": "#/$defs/money_metric"}
      }
    },
    "positions_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reporting_period", "snapshot_date", "accounts", "instruments", "items", "deposits", "cash_balances"],
      "properties": {
        "reporting_period": {"$ref": "#/$defs/period"},
        "snapshot_date": {"type": "string", "format": "date"},
        "accounts": {"type": "array", "items": {"$ref": "#/$defs/account"}},
        "instruments": {"type": "array", "items": {"$ref": "#/$defs/instrument"}},
        "items": {"type": "array", "items": {"$ref": "#/$defs/position"}},
        "deposits": {"type": "array", "items": {"$ref": "#/$defs/deposit"}},
        "cash_balances": {"type": "array", "items": {"$ref": "#/$defs/cash_balance"}}
      }
    },
    "passive_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deposit_interest", "bond_coupons", "dividends", "other_capital_income"],
      "properties": {
        "deposit_interest": {"$ref": "#/$defs/money_metric"},
        "bond_coupons": {"$ref": "#/$defs/money_metric"},
        "dividends": {"$ref": "#/$defs/money_metric"},
        "other_capital_income": {"$ref": "#/$defs/money_metric"}
      }
    },
    "dynamics_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "status",
        "snapshot_date",
        "coverage",
        "liquid_assets_total",
        "included_debts",
        "liquid_capital_net",
        "passive_income_actual",
        "active_income_net",
        "mandatory_expenses",
        "saving_allocations",
        "monthly_cash_balance",
        "property_equity",
        "market_value_change",
        "investment_return",
        "warning_codes"
      ],
      "properties": {
        "period": {"$ref": "#/$defs/period"},
        "status": {"enum": ["closed", "draft"]},
        "snapshot_date": {"type": "string", "format": "date"},
        "coverage": {"$ref": "#/$defs/coverage_state"},
        "liquid_assets_total": {"$ref": "#/$defs/money_metric"},
        "included_debts": {"$ref": "#/$defs/money_metric"},
        "liquid_capital_net": {"$ref": "#/$defs/money_metric"},
        "passive_income_actual": {"$ref": "#/$defs/money_metric"},
        "active_income_net": {"$ref": "#/$defs/money_metric"},
        "mandatory_expenses": {"$ref": "#/$defs/money_metric"},
        "saving_allocations": {"$ref": "#/$defs/money_metric"},
        "monthly_cash_balance": {"$ref": "#/$defs/money_metric"},
        "property_equity": {"$ref": "#/$defs/money_metric"},
        "market_value_change": {"$ref": "#/$defs/money_metric"},
        "investment_return": {"$ref": "#/$defs/ratio_metric"},
        "warning_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "dynamics_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "missing_calendar_periods"],
      "properties": {
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dynamics_point"}
        },
        "missing_calendar_periods": {
          "type": "array",
          "items": {"$ref": "#/$defs/period"}
        }
      }
    },
    "rolling_average": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "eligible_month_count",
        "target_window_months",
        "is_complete_window",
        "history_start_period",
        "periods_used",
        "source"
      ],
      "properties": {
        "value": {"$ref": "#/$defs/money_metric"},
        "eligible_month_count": {"type": "integer", "minimum": 0, "maximum": 12},
        "target_window_months": {"const": 12},
        "is_complete_window": {"type": "boolean"},
        "history_start_period": {"$ref": "#/$defs/period"},
        "periods_used": {"type": "array", "items": {"$ref": "#/$defs/period"}},
        "source": {"const": "eligible_closed_reporting_months"}
      }
    },
    "passive_forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_version",
        "as_of_date",
        "annual_total",
        "monthly_total",
        "breakdown",
        "dividend_component_source",
        "deposit_projection_method",
        "warning_codes"
      ],
      "properties": {
        "forecast_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "as_of_date": {"type": "string", "format": "date"},
        "annual_total": {"$ref": "#/$defs/money_metric"},
        "monthly_total": {"$ref": "#/$defs/money_metric"},
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_deposit_interest",
            "expected_coupon_component",
            "expected_dividend_component",
            "other_expected_capital_income"
          ],
          "properties": {
            "expected_deposit_interest": {"$ref": "#/$defs/money_metric"},
            "expected_coupon_component": {"$ref": "#/$defs/money_metric"},
            "expected_dividend_component": {"$ref": "#/$defs/money_metric"},
            "other_expected_capital_income": {"$ref": "#/$defs/money_metric"}
          }
        },
        "dividend_component_source": {"const": "actual_closed_month_dividend_average_annualized"},
        "deposit_projection_method": {
          "const": "persisted_monthly_estimate_times_12_plus_expected_interest"
        },
        "warning_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "passive_income_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_history_metric_path", "rolling_actual_average", "forecast"],
      "properties": {
        "actual_history_metric_path": {
          "const": "sections.dynamics.data.history[].passive_income_actual"
        },
        "rolling_actual_average": {"$ref": "#/$defs/rolling_average"},
        "forecast": {"$ref": "#/$defs/passive_forecast"}
      }
    },
    "cash_flow_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ref",
        "expected_date",
        "flow_type",
        "account_ref",
        "instrument_ref",
        "amount",
        "amount_semantics",
        "personal_tax_status",
        "is_approximate",
        "reason_codes",
        "provenance",
        "duplicate_resolution",
        "included_in_calendar_total",
        "included_in_passive_income_forecast",
        "forecast_treatment"
      ],
      "properties": {
        "event_ref": {"type": "string", "pattern": "^flow-[a-z0-9-]+$"},
        "expected_date": {"type": "string", "format": "date"},
        "flow_type": {"enum": ["coupon", "dividend", "interest", "redemption", "other"]},
        "account_ref": {"type": "string", "pattern": "^acct-[a-z0-9-]+$"},
        "instrument_ref": {
          "type": ["string", "null"],
          "pattern": "^inst-[a-z0-9-]+$"
        },
        "amount": {"$ref": "#/$defs/money"},
        "amount_semantics": {
          "enum": [
            "owner_expected_net",
            "owner_expected_amount_tax_unknown",
            "provider_announced_amount_tax_unknown",
            "principal"
          ]
        },
        "personal_tax_status": {"enum": ["known_or_accounted", "unknown", "not_applicable"]},
        "is_approximate": {"type": "boolean"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "duplicate_resolution": {
          "enum": ["none", "count_provider", "count_manual", "unresolved_manual_only"]
        },
        "included_in_calendar_total": {"const": true},
        "included_in_passive_income_forecast": {"type": "boolean"},
        "forecast_treatment": {
          "enum": ["included", "represented_by_historical_component", "excluded_principal"]
        }
      }
    },
    "future_cash_flows_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_start",
        "window_end_exclusive",
        "forecast_version",
        "non_principal_calendar_amount_total",
        "principal_total",
        "calendar_total",
        "items",
        "warning_codes"
      ],
      "properties": {
        "window_start": {"type": "string", "format": "date"},
        "window_end_exclusive": {"type": "string", "format": "date"},
        "forecast_version": {"type": "string", "minLength": 1, "maxLength": 64},
